# HireLens Environment Variables Template
# Copy this file to '.env' and fill in your actual credentials.
# Never commit the real .env - it is listed in .gitignore.

# --- Azure OpenAI (required) ---
AZURE_API_KEY=
AZURE_API_BASE=https://your-resource-name.openai.azure.com/
AZURE_API_VERSION=2024-12-01-preview

# Name of your Azure deployment for the resume extraction model.
AZURE_DEPLOYMENT_NAME=gpt-4o-mini

# --- CrewAI (optional) ---
# LiteLLM-style model string used by the CrewAI agents.
CREWAI_LLM_MODEL=azure/gpt-4o-mini
